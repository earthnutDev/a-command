{
  "name": "a-command-root",
  "type": "module",
  "private": true,
  "description": "一款优秀的终端工具",
  "scripts": {
    "diff": "jja pkg --diff",
    "eslint": "jja cls && eslint packages",
    "beautify": "npm run eslint && npm run prettier",
    "prettier": "jja cls && prettier . --write",
    "push:version": "gvv",
    "push": "gvv",
    "prepare": "husky",
    "prepublishOnly": "pjj"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx,jex,md,mdx}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@qqi/check-version": "^1.0.2",
    "@qqi/rollup-external": "^1.0.5",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^24.0.0",
    "a-node-tools": "^4.2.6",
    "a-type-of-js": "^1.0.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsdoc": "^50.7.1",
    "globals": "^16.2.0",
    "gvv": "^0.0.7",
    "husky": "^9.1.7",
    "javascript-obfuscator": "^4.1.1",
    "jja": "^2.3.8",
    "lint-staged": "^16.1.0",
    "pjj": "^1.0.1",
    "prettier": "^3.5.3",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-obfuscator": "^1.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vjj": "^1.0.5"
  }
}
