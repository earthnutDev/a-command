{
  "type": "module",
  "private": true,
  "version": "2.3.13",
  "name": "a-command",
  "description": "一点点 🤏 终端工具 🧰",
  "scripts": {
    "b": "rollup --config rollup.config.js && tsc -p tsconfig.types.json",
    "build": "jja rm dist cls&& npm run b && npm run clean:package",
    "clean:package": "node scripts/clean-package-json.js",
    "diff": "jja pkg --diff",
    "dev": "jja rm .eg cls cls  && rollup --config rollup.dev.config.js && node .eg/eg/index.mjs ",
    "push:version": "gvv",
    "push": "gvv",
    "eslint": "eslint src",
    "beautify": "npm run prettier",
    "prettier": "prettier . --write",
    "test": "lint-staged && jest --coverage",
    "report": "cat ./coverage/lcov.info | coveralls",
    "coverage": "codecov",
    "vjj": "vjj -b",
    "prepublishOnly": "pjj"
  },
  "license": "MIT",
  "dependencies": {
    "@color-pen/static": "^1.0.0",
    "@qqi/log": "^0.1.0",
    "a-js-tools": "^1.0.8",
    "a-node-tools": "^4.2.16",
    "a-type-of-js": "^1.0.5",
    "color-pen": "^2.0.12"
  }
}
